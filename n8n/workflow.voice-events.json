                                         "functionCode":  "// ======================================================================\n// DISABLED STUB â€” enable this before production!\n// Verify the HMAC signature Vobiz/your emitter sends so nobody can POST\n// fake call events to your public webhook.\n//\n// 1. Enable this node (right-click â†’ Enable).\n// 2. Set REC/WEBHOOK secret as an n8n env var (e.g. $env.VOICE_EVENTS_SECRET).\n// 3. Compare the computed HMAC to the incoming signature header.\n// ======================================================================\nconst crypto = require(\u0027crypto\u0027);\nconst secret = $env.VOICE_EVENTS_SECRET || \u0027\u0027;\nconst sig = $json.headers \u0026\u0026 $json.headers[\u0027x-signature\u0027];\nconst raw = JSON.stringify($json.body || {});\nconst expected = crypto.createHmac(\u0027sha256\u0027, secret).update(raw).digest(\u0027hex\u0027);\nif (!secret || sig !== expected) {\n  throw new Error(\u0027Invalid HMAC signature â€” rejecting event\u0027);\n}\nreturn items;"
